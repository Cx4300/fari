# FARADAY AI - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# LLM Configuration
# ============================================================================

# Primary LLM Provider (openai, anthropic, local)
PRIMARY_LLM_PROVIDER=openai

# API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model Names
OPENAI_MODEL=gpt-4
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
LOCAL_MODEL=gpt-oss-20b

# Generation Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TOP_P=1.0
LLM_FREQUENCY_PENALTY=0.0
LLM_PRESENCE_PENALTY=0.0

# Streaming
LLM_ENABLE_STREAMING=true
ENABLE_FUNCTION_CALLING=true

# ============================================================================
# RAG (Retrieval-Augmented Generation) Configuration
# ============================================================================

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Search
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# ============================================================================
# TTS (Text-to-Speech) Configuration
# ============================================================================

# Enable TTS
ENABLE_TTS=true

# TTS Models
TTS_MODEL_HR=tts_models/hr/cv/vits
TTS_MODEL_EN=tts_models/en/ljspeech/tacotron2-DDC

# Default Language (hr, en)
TTS_DEFAULT_LANGUAGE=hr

# ============================================================================
# Agent Configuration
# ============================================================================

ENABLE_AGENTS=true
AGENT_MAX_ITERATIONS=10

# ============================================================================
# Tools Configuration
# ============================================================================

# Enabled Tools (comma-separated)
ENABLED_TOOLS=web_search,code_interpreter,calculator,artifact_generator,rag

# Web Search
WEB_SEARCH_API_KEY=your-web-search-api-key
WEB_SEARCH_ENGINE=duckduckgo

# ============================================================================
# Connectors Configuration
# ============================================================================

# Enabled Connectors (comma-separated)
ENABLED_CONNECTORS=

# Gmail
# GMAIL_CREDENTIALS_PATH=credentials/gmail_credentials.json
# GMAIL_TOKEN_PATH=credentials/gmail_token.json

# WhatsApp (Twilio)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# N8N
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id
# N8N_API_KEY=your-n8n-api-key

# ============================================================================
# Authentication Configuration
# ============================================================================

AUTH_ENABLED=false
# DATABASE_URL=sqlite:///data/users.db
# JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production

# ============================================================================
# Logging Configuration
# ============================================================================

LOG_LEVEL=INFO

# ============================================================================
# Notes
# ============================================================================

# 1. For OpenAI: Get API key from https://platform.openai.com/api-keys
# 2. For Anthropic: Get API key from https://console.anthropic.com/
# 3. For Gmail: Follow OAuth 2.0 setup at https://developers.google.com/gmail/api
# 4. For Twilio WhatsApp: Sign up at https://www.twilio.com/
# 5. For N8N: Self-host or use https://n8n.io/
# 6. TTS models will be downloaded automatically on first use

# Security Warning:
# - Never commit .env file to version control
# - Keep your API keys secure
# - Use environment variables in production
